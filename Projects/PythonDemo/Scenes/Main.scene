# Lapis Scene v1 - Python scripting example
Scene name="PythonDemo"
Environment zenith=0.18,0.34,0.78 horizon=0.75,0.82,0.95 ground=0.25,0.24,0.22 ambient=0.5 reflection=1 fog=0.004 exposure=1

Entity id=1 name="Camera"
  Transform position=0,6,13 rotation=-22,0,0
  Camera fov=60 near=0.1 far=300 primary=1

Entity id=2 name="Sun"
  Transform position=0,10,0 rotation=-50,30,0
  Light type=Directional color=1,0.95,0.86 intensity=3.2 shadows=1

Entity id=3 name="Ground"
  Transform position=0,-0.5,0 scale=30,1,30
  MeshRenderer mesh="Cube" color=0.6,0.66,0.62,1 roughness=0.95 texture="Checker" tiling=8,8
  Collider shape=Box

Entity id=4 name="Spinner"
  Transform position=-4,1.5,0 scale=1.2,1.2,1.2
  MeshRenderer mesh="Cube" color=1,0.55,0.2,1 roughness=0.4
  Script path="Scripts/Spinner.py"

Entity id=5 name="Spawner"
  Transform position=1,8,0
  Script path="Scripts/BallSpawner.py"

Entity id=6 name="Bumper"
  Transform position=1,0.25,0 scale=4,0.5,4
  MeshRenderer mesh="Cube" color=0.3,0.4,1,1 roughness=0.3
  Collider shape=Box
